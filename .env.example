# --- ENTSO-E -----------------------------------------------------------------
# Token de ENTSO-E. Se obtiene registrandose en la Transparency Platform y
# pidiendolo por correo a transparency@entsoe.eu. No se versiona nunca:
# .env esta en .gitignore y aqui solo queda el placeholder.
ENTSOE_SECURITY_TOKEN=pon-aqui-tu-token

# --- ETL ---------------------------------------------------------------------
DAYAHEAD_SINK=duckdb
DAYAHEAD_DB=data/dayahead.duckdb

# --- API ---------------------------------------------------------------------
# Clave para pedir token. Generar una propia: python -c "import secrets;print(secrets.token_urlsafe(32))"
DAYAHEAD_API_KEYS=demo-key-cambiar-en-produccion
DAYAHEAD_JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio
DAYAHEAD_JWT_TTL_MINUTES=60
DAYAHEAD_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
